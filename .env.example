# Copy to .env for local testing (never commit .env).
# On Vercel/Netlify set these in the dashboard instead.

# Resend API key — https://resend.com/api-keys  (server-side only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where new reservation requests are delivered
BOOKING_TO_EMAIL=manhquan281003@gmail.com

# Sender. Until you verify a domain in Resend, use onboarding@resend.dev —
# it can only deliver to the email address that owns the Resend account.
BOOKING_FROM_EMAIL="LACA 24 Đặt bàn <onboarding@resend.dev>"

# Optional: also email the guest an acknowledgement ("not yet confirmed").
# Requires a verified sending domain in Resend. true | false
SEND_CUSTOMER_ACK=false

# Optional: comma-separated origins allowed to POST (e.g. https://laca24.vn).
# Leave empty to accept same-site requests from any deployed URL.
ALLOWED_ORIGINS=

# Optional anti-spam: Cloudflare Turnstile secret. When set, the frontend
# must also render the widget and send `turnstileToken` (see README).
TURNSTILE_SECRET_KEY=
